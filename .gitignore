###########################################################
# 📦 Node / JS
###########################################################
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json

# Lock files for local package managers (optional, can keep if consistent)
# npm-lock, yarn.lock, pnpm-lock.yaml are optional — comment if you want to keep them

###########################################################
# 🧠 Next.js & React
###########################################################
.next/
out/
dist/
build/
.cache/
.vercel/
*.log

# Next.js build output for static exports
.next/static
.next/cache

###########################################################
# ⚙️ Turborepo
###########################################################
turbo/
.turbo/
.cache/
.tmp/

###########################################################
# 💥 Chrome Extension (Vite/Rollup/Webpack)
###########################################################
extension-build/
extension-dist/
extension-temp/
extension/.env*

# Vite cache
.vite/
vite.config.ts.timestamp*
vite-env.d.ts

###########################################################
# 🧰 Supabase
###########################################################
# Supabase local dev artifacts
.supabase/
supabase/.temp/
supabase/.env
.supabase/functions/.env
supabase/functions/node_modules/
supabase/migrations/.history/
supabase/.branches/

# Local docker Postgres volumes
docker/volumes/
pg_data/

###########################################################
# 🔐 Environment variables
###########################################################
.env
.env.*
!.env.example   # keep this for documentation

###########################################################
# 🧪 Testing / Coverage
###########################################################
coverage/
.nyc_output/
__tests__/tmp/
jest-test-result.json

###########################################################
