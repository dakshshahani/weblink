.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace
*.iml

###########################################################
# 💡 Misc
###########################################################
temp/
tmp/
logs/
*.bak
*.tmp
*.pid
*.seed
*.orig
*.rej

###########################################################
# 🚫 Security
###########################################################
# Never commit secrets, service keys, or credentials
*.pem
*.key
*.cert
*.p12
*.crt
*.csr